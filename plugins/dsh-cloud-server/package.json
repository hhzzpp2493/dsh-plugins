{
  "name": "dsh-cloud-server",
  "version": "0.1.0",
  "description": "把「连接云服务器」封装成 dsh 工具：cloud_ssh 在云服务器上执行命令、cloud_status 检查 dsh 与服务健康，随时远程运维不再手动 SSH。",
  "private": false,
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./tools": "./tools/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cloud",
    "server",
    "ssh",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    }
  }
}
