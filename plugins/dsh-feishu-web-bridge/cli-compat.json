{
  "cliVersion": "1.0.89",
  "testedAt": "2026-09-07",
  "nodeVersion": ">=22",
  "commands": {
    "im.+messages-send": {
      "requiredFlags": ["--chat-id", "--text|--file|--markdown|--image"],
      "optionalFlags": ["--as", "--idempotency-key"],
      "outputFields": ["message_id", "chat_id"],
      "exitCode": 0,
      "status": "verified"
    },
    "im.+messages-resources-download": {
      "requiredFlags": ["--message-id", "--file-key", "--type", "--output"],
      "optionalFlags": ["--as"],
      "outputFields": ["saved_path|path|output|file"],
      "exitCode": 0,
      "status": "verified"
    },
    "event.consume": {
      "requiredFlags": ["<EventKey>", "--as"],
      "outputFormat": "NDJSON",
      "stderrMarkers": ["[event] ready"],
      "status": "verified"
    },
    "drive.+upload": {
      "requiredFlags": ["--file"],
      "optionalFlags": ["--folder-token", "--name", "--as"],
      "outputFields": ["file_token", "file_name"],
      "status": "verified"
    },
    "drive.+download": {
      "requiredFlags": ["--file-token"],
      "optionalFlags": ["--as"],
      "outputFields": ["saved_path"],
      "status": "verified"
    },
    "drive.+search": {
      "requiredFlags": ["--query"],
      "optionalFlags": ["--as"],
      "outputFields": ["files[]"],
      "status": "verified"
    },
    "docs.+create": {
      "requiredFlags": ["--title", "--doc-format"],
      "optionalFlags": ["--content", "--parent-token", "--as"],
      "outputFields": ["token|document_id|doc_token", "url|permalink"],
      "status": "verified"
    }
  },
  "rawApiFallback": {
    "enabled": true,
    "endpoints": {
      "sendMessage": "POST /open-apis/im/v1/messages?receive_id_type=chat_id",
      "downloadResource": "GET /open-apis/im/v1/messages/{message_id}/resources/{file_key}",
      "uploadFile": "POST /open-apis/drive/v1/files/upload_all",
      "createDoc": "POST /open-apis/docx/v1/documents"
    }
  }
}
